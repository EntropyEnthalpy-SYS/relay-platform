{
  "api_version": 1,
  "node_id": "local-health",
  "revision": 1,
  "rules": [{
    "id": "health-echo",
    "tenant_id": "default",
    "owner_id": "admin",
    "name": "Echo with active target checks",
    "listen": "127.0.0.1:19001",
    "protocol": "both",
    "enabled": true,
    "meter_epoch": "initial",
    "targets": [{"address": "127.0.0.1:19000", "weight": 1, "priority": 0, "max_sessions": 128}],
    "health_check": {
      "interval_ms": 1000,
      "timeout_ms": 500,
      "unhealthy_threshold": 2,
      "healthy_threshold": 2,
      "recovery_delay_ms": 2000,
      "max_age_ms": 5000,
      "tcp": {"kind": "exchange", "request_base64": "UElORw==", "expected_base64": "UElORw==", "half_close": false},
      "udp": {"request_base64": "UElORw==", "expected_base64": "UElORw=="}
    }
  }]
}
